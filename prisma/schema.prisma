generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // foreign key (kinde ids)
  workspaceId String // Kinde organization ID
  createdById String // Kinde user ID
  mesages     Mesage[]

  @@unique([workspaceId, name])
}

model Mesage {
  id           String   @id @default(uuid())
  content      String
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  authorId     String
  authorEmail  String
  authorName   String
  authorAvatar String
  Channel      Channel? @relation(fields: [channelId], references: [id])
  channelId    String?

  // Thread relations
  parentMessage    Mesage?           @relation("MessageThread", fields: [threadId], references: [id], onDelete: Cascade)
  threadId         String?
  replies          Mesage[]          @relation("MessageThread")
  messageReactions MessageReaction[]
}

model MessageReaction {
  id        String   @id @default(uuid())
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User Data
  userId     String
  userEmail  String
  userName   String
  userAvatar String

  // Message Data
  mesage   Mesage @relation(fields: [mesageId], references: [id], onDelete: Cascade)
  mesageId String

  @@unique([mesageId, emoji, userId])
}
